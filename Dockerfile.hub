# Trailbox Hub — slim Linux container.
# Bundles only the server-side bits (no Qt / no capture). ffmpeg comes from
# imageio-ffmpeg's vendored binary, so no apt install is needed.
#
# Build:   docker build -f Dockerfile.hub -t trailbox-hub .
# Run:     docker run --rm -p 8765:8765 -v $(pwd)/hub_data:/data \
#              -e TRAILBOX_HUB_ADMIN_USER=admin \
#              -e TRAILBOX_HUB_ADMIN_PASS='choose-something-strong' \
#              trailbox-hub
#
# Bootstrap modes (pick one):
#   1. Set TRAILBOX_HUB_ADMIN_USER + TRAILBOX_HUB_ADMIN_PASS on first boot.
#   2. Leave them unset — a one-time setup token is printed to stderr and
#      written to /data/.setup_token; visit /setup in a browser.
#   3. Legacy: set TRAILBOX_HUB_TOKEN for the old shared-token compat path
#      (treated as admin service-token). Not recommended for new installs.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TRAILBOX_HUB_DATA=/data \
    TRAILBOX_HUB_HOST=0.0.0.0 \
    TRAILBOX_HUB_PORT=8765

WORKDIR /app

# Install Python deps first so the layer caches across code changes.
COPY requirements-hub.txt ./
RUN pip install --no-cache-dir -r requirements-hub.txt

# Copy only the modules the server actually needs.
# core/trim, timeline_utils, viewer_generator landed when the Hub gained the
# session-trim endpoint (v0.14.0): the trim engine ffmpeg-cuts screen.mp4 and
# regenerates viewer.html for the new clip server-side, so the container
# needs those three on top of the frame_extractor that get_frame_at uses.
COPY hub_server/ ./hub_server/
COPY core/__init__.py core/frame_extractor.py core/trim.py core/timeline_utils.py core/viewer_generator.py ./core/
COPY hub_entry.py ./

# Storage volume mount point.
RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8765

# Refuse to bind 0.0.0.0 without a token (the entrypoint enforces this).
CMD ["python", "hub_entry.py"]
