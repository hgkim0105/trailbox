# Copy to .env and edit before `docker compose up`.

# ---- First-boot admin bootstrap (0.5.0+) -----------------------------------
# Fill these in to auto-create the first admin account on first boot.
# Leave empty to fall back to the one-time setup-token flow (printed on
# first boot, also written to hub_data/.setup_token — visit /setup).
TRAILBOX_HUB_ADMIN_USER=
TRAILBOX_HUB_ADMIN_PASS=

# Auto-approve new registrations. 1 = active immediately, 0 = pending admin
# approval (default). Only seeded on first boot; change at runtime in
# /admin/settings.
TRAILBOX_HUB_AUTO_APPROVE=0

# Cookie signing key. Optional — auto-generated and persisted to
# hub_data/.secret_key on first boot if empty.
# Generate manually:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TRAILBOX_HUB_SECRET_KEY=

# ---- Legacy service-token (back-compat with pre-0.5.0 clients) -------------
# When set, requests carrying this in X-Trailbox-Token authenticate as the
# first admin. New deployments should leave it empty and use accounts.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TRAILBOX_HUB_TOKEN=

# ---- Operational knobs -----------------------------------------------------
# Days to keep uploaded sessions before auto-deletion. 0 = forever.
TRAILBOX_HUB_RETENTION_DAYS=0

# Cap on a single session upload (MB).
TRAILBOX_HUB_MAX_UPLOAD_MB=8192

# Only needed if you uncomment the caddy service for public TLS.
# TRAILBOX_HUB_DOMAIN=hub.example.com
